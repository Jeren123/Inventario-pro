# ── Base de datos ──────────────────────────────────────────────────────────────
# Reemplaza TU_PASSWORD con tu contraseña real de MySQL
DATABASE_URL=mysql+pymysql://USUSARIO:TUCLAVE@localhost:3306/inventario_inteligente

# ── Seguridad JWT ──────────────────────────────────────────────────────────────
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# ── Tiempo de expiración del token ────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Ollama (IA local) ──────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b


# ── Telegram Bot ───────────────────────────────────────────────────────────────
# 1. Habla con @BotFather en Telegram -> /newbot -> copia el token aqui
TELEGRAM_BOT_TOKEN="ejemplo telegram bot"

# 2. Habla con @userinfobot en Telegram para obtener tu ID
TELEGRAM_CHAT_ID="ejemplo telegram id"

# ── CORS / Frontend ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
